generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

// ===================== ENUMS =====================

enum EstadoEmpleado {
  ACTIVO
  INACTIVO
}

enum TipoSolicitud {
  VACACION
  PERMISO
  INCAPACIDAD
}

enum EstadoSolicitud {
  PENDIENTE
  APROBADA
  RECHAZADA
}

enum TurnoHorario {
  T12_20 @map("12:00-20:00")
  T12_22 @map("12:00-22:00")
}

enum EstadoHorario {
  ACTIVO
  MODIFICADO
}

enum TipoNotificacion {
  HORARIO
  VACACION
  LLAMADO
  NOMINA
}

enum AccionBitacora {
  INSERT
  UPDATE
  DELETE
}

enum EstadoCandidato {
  EN_PROCESO
  CONTRATADO
  DESCARTADO
}

enum EtapaReclutamiento {
  APLICACION
  REVISION_CV
  ENTREVISTA
  EVALUACION
  OFERTA
  CONTRATADO
}

enum ResultadoEntrevista {
  APROBADO
  REPROBADO
  PENDIENTE
}

// Estados del flujo de procesamiento de la nómina
enum EstadoNomina {
  PENDIENTE
  PROCESADO
  PAGADO
}

// ===================== CATÁLOGOS =====================

model Role {
  id          Int          @id @default(autoincrement())
  nombre      String       @unique
  descripcion String?
  usuarios    Usuario[]
  permisos    PermisoRol[] // Relación para los permisos dinámicos
}

model Area {
  id          Int      @id @default(autoincrement())
  nombre      String   @unique
  descripcion String?

  vacantes  Vacante[]
  puestos   Puesto[]
  empleados Empleado[]
  horarios  Horario[]
}

model Puesto {
  id     Int    @id @default(autoincrement())
  nombre String
  areaId Int

  area      Area       @relation(fields: [areaId], references: [id])
  empleados Empleado[]
}

// ===================== EMPLEADOS Y ACCESO =====================

model Empleado {
  id           Int            @id @default(autoincrement())
  nombres      String
  apellidos    String
  identidad    String         @unique
  telefono     String
  correo       String         @unique
  puestoId     Int
  areaId       Int
  salarioBase  Float
  fechaIngreso DateTime
  estado       EstadoEmpleado @default(ACTIVO)
  fechaBaja    DateTime?
  motivoBaja   String?

  candidatoId Int? @unique

  puesto    Puesto     @relation(fields: [puestoId], references: [id])
  area      Area       @relation(fields: [areaId], references: [id])
  candidato Candidato? @relation(fields: [candidatoId], references: [id])

  usuario          Usuario?
  expedientes      Expediente[]
  horarios         Horario[]
  solicitudes      Solicitud[]
  descansos        Descanso[]
  llamados         LlamadoAtencion[]
  nominas          Nomina[]
  detallesPlanilla DetallePlanillaNomina[] // Relación con los detalles individuales de nómina
  reportes         ReporteIncidencia[]
}

model Usuario {
  id                Int       @id @default(autoincrement())
  username          String    @unique
  password          String
  roleId            Int
  activo            Boolean   @default(true)
  ultimoAcceso      DateTime?
  tokenRecuperacion String?
  tokenExpira       DateTime?
  empleadoId        Int       @unique

  role                 Role                 @relation(fields: [roleId], references: [id])
  empleado             Empleado             @relation(fields: [empleadoId], references: [id])
  expedientesCargados  Expediente[]
  solicitudesAprobadas Solicitud[]
  horariosCreados      Horario[]
  llamadosEmitidos     LlamadoAtencion[]
  nominasRegistradas   Nomina[]
  planillasCreadas     PlanillaNomina[]     // Planillas globales generadas por el usuario
  entrevistas          Entrevista[]
  notificaciones       Notificacion[]
  bitacora             Bitacora[]
  descansosCreados     Descanso[]
}

// ===================== EXPEDIENTE =====================

model Expediente {
  id            Int      @id @default(autoincrement())
  tipoDocumento String
  archivo       String
  fechaCarga    DateTime @default(now())
  empleadoId    Int
  cargadoPorId  Int

  empleado   Empleado @relation(fields: [empleadoId], references: [id])
  cargadoPor Usuario  @relation(fields: [cargadoPorId], references: [id])
}

// ===================== RECLUTAMIENTO =====================

model Candidato {
  id             Int                @id @default(autoincrement())
  nombre         String
  apellido       String
  telefono       String?
  email          String?
  puestoAplicado String
  cvArchivo      String?
  identidad       String?
  direccion       String?
  referencias     String?
  fotoArchivo     String?
  vacanteId       Int?
  estado         EstadoCandidato    @default(EN_PROCESO)
  etapa          EtapaReclutamiento @default(APLICACION)
  fechaRegistro  DateTime           @default(now())
  motivoDescarte String?
  fechaDescarte  DateTime?

  entrevistas Entrevista[]
  vacante    Vacante?    @relation(fields: [vacanteId], references: [id], onDelete: SetNull, onUpdate: Cascade)
  postulante Postulante?
  empleado    Empleado?
  evaluacion  Evaluacion?
  oferta      Oferta?
}

// Catálogo de vacantes visible para administradores y postulantes.
model Vacante {
  id            Int       @id @default(autoincrement())
  nombre        String
  descripcion   String
  areaId        Int
  activa        Boolean   @default(true)
  fechaCreacion DateTime  @default(now())
  plazasTotales Int       @default(1)

  area       Area        @relation(fields: [areaId], references: [id])
  candidatos Candidato[]
}

// Cuenta de postulante independiente de Usuario/Empleado.
// No se requiere crear un empleado para registrarse a una vacante.
model Postulante {
  id           Int       @id @default(autoincrement())
  nombre       String
  apellido     String
  email        String    @unique
  password     String
  telefono     String?
  direccion    String?
  referencias  String?
  observaciones String?
  fotoArchivo  String?
  candidatoId  Int?      @unique
  fechaRegistro DateTime @default(now())

  candidato Candidato? @relation(fields: [candidatoId], references: [id], onDelete: SetNull)
}

model Entrevista {
  id               Int                 @id @default(autoincrement())
  fase             Int
  resultado        ResultadoEntrevista @default(PENDIENTE)
  observaciones    String?
  fecha            DateTime
  estadoEntrevista String              @default("PENDIENTE")
  modalidad        String              @default("PRESENCIAL")
  indicaciones     String?
  documentoArchivo String?
  candidatoId      Int
  entrevistadorId  Int

  candidato     Candidato @relation(fields: [candidatoId], references: [id])
  entrevistador Usuario   @relation(fields: [entrevistadorId], references: [id])
}

model Evaluacion {
  id              Int       @id @default(autoincrement())
  candidatoId     Int       @unique
  puntuacion      Int
  clasificacion   String
  observaciones   String
  resultado       String    @default("PENDIENTE")
  fechaEvaluacion DateTime  @default(now())

  candidato Candidato @relation(fields: [candidatoId], references: [id])
}

model Oferta {
  id             Int       @id @default(autoincrement())
  candidatoId    Int       @unique
  tipoContrato   String
  salario        Decimal
  fechaInicio    DateTime
  estado         String    @default("PENDIENTE")
  fechaOferta    DateTime  @default(now())
  fechaRespuesta DateTime?

  candidato Candidato @relation(fields: [candidatoId], references: [id])
}

// ===================== HORARIOS =====================

model Horario {
  id            Int           @id @default(autoincrement())
  fechaInicio   DateTime
  fechaFin      DateTime
  turno         TurnoHorario
  estado        EstadoHorario @default(ACTIVO)
  fechaCreacion DateTime      @default(now())
  empleadoId    Int
  areaId        Int
  creadoPorId   Int

  empleado  Empleado @relation(fields: [empleadoId], references: [id])
  area      Area     @relation(fields: [areaId], references: [id])
  creadoPor Usuario  @relation(fields: [creadoPorId], references: [id])

  @@unique([empleadoId, fechaInicio, fechaFin])
}

// ===================== VACACIONES Y PERMISOS =====================

model Solicitud {
  id                Int             @id @default(autoincrement())
  tipoSolicitud     TipoSolicitud
  fechaInicio       DateTime
  fechaFin          DateTime
  motivo            String?
  estado            EstadoSolicitud @default(PENDIENTE)
  comentarioGerente String?
  aprobadoPorId     Int?
  fechaSolicitud    DateTime        @default(now())
  empleadoId        Int

  empleado    Empleado  @relation(fields: [empleadoId], references: [id])
  aprobadoPor Usuario?  @relation(fields: [aprobadoPorId], references: [id])
}

// ===================== CONTROL DISCIPLINARIO =====================

model LlamadoAtencion {
  id               Int       @id @default(autoincrement())
  descripcionFalta String
  tipoFalta        String
  fecha            DateTime
  numeroLlamado    Int
  firmadoEmpleado  Boolean   @default(false)
  fechaFirma       DateTime?
  empleadoId       Int
  emisorId         Int

  empleado Empleado @relation(fields: [empleadoId], references: [id])
  emisor   Usuario  @relation(fields: [emisorId], references: [id])
}

// ===================== NÓMINA / PLANILLAS =====================

model Nomina {
  id              Int      @id @default(autoincrement())
  periodoInicio   DateTime
  periodoFin      DateTime
  salarioBase     Float
  deducciones     Float    @default(0)
  bonificaciones  Float    @default(0)
  salarioNeto     Float
  fechaPago       DateTime
  empleadoId      Int
  registradoPorId Int

  empleado      Empleado @relation(fields: [empleadoId], references: [id])
  registradoPor Usuario  @relation(fields: [registradoPorId], references: [id])
}

model PlanillaNomina {
  id             Int      @id @default(autoincrement())
  periodo        String
  empresa        String   @default("Vito Pizzeria")
  totalNeto      Float    @default(0)
  totalBruto     Float    @default(0)
  totalDeduccion Float    @default(0)
  porProcesar    Int      @default(0)
  fechaCreacion  DateTime @default(now())
  creadoPorId    Int

  creadoPor Usuario                 @relation(fields: [creadoPorId], references: [id])
  detalles  DetallePlanillaNomina[]
}

model DetallePlanillaNomina {
  id           Int          @id @default(autoincrement())
  planillaId   Int
  empleadoId   Int
  salarioBase  Float
  horasExtra   Float        @default(0)
  montoHorasEx Float        @default(0)
  bonos        Float        @default(0)
  conceptoBono String?
  deducciones  Float        @default(0)
  salarioNeto  Float
  estado       EstadoNomina @default(PENDIENTE)

  planilla PlanillaNomina @relation(fields: [planillaId], references: [id])
  empleado Empleado       @relation(fields: [empleadoId], references: [id])
}

// ===================== REPORTES E INCIDENCIAS =====================

model ReporteIncidencia {
  id           Int      @id @default(autoincrement())
  empleado     String
  tipo         String
  gravedad     String
  supervisor   String
  fecha        String
  descripcion  String
  seguimiento  String?
  documentoUrl String?
  createdAt    DateTime @default(now())

  empleadoId   Int?
  empleado_rel Empleado? @relation(fields: [empleadoId], references: [id])
}

// ===================== NOTIFICACIONES Y AUDITORÍA =====================

model Notificacion {
  id         Int              @id @default(autoincrement())
  tipo       TipoNotificacion
  mensaje    String
  leida      Boolean          @default(false)
  fechaEnvio DateTime         @default(now())
  usuarioId  Int

  usuario Usuario @relation(fields: [usuarioId], references: [id])
}

model Bitacora {
  id            Int            @id @default(autoincrement())
  tablaAfectada String
  idRegistro    Int
  accion        AccionBitacora
  descripcion   String?
  fechaHora     DateTime       @default(now())
  ipOrigen      String?
  usuarioId     Int

  usuario Usuario @relation(fields: [usuarioId], references: [id])
}

// ===================== DESCANSOS =====================

model Descanso {
  id            Int      @id @default(autoincrement())
  fecha         DateTime
  fechaCreacion DateTime @default(now())
  empleadoId    Int
  creadoPorId   Int

  empleado  Empleado @relation(fields: [empleadoId], references: [id])
  creadoPor Usuario  @relation(fields: [creadoPorId], references: [id])

  @@unique([empleadoId, fecha])
}

// ===================== PERMISOS DINÁMICOS POR ROL =====================

model PermisoRol {
  id      Int     @id @default(autoincrement())
  roleId  Int
  modulo  String
  visible Boolean @default(false)

  role Role @relation(fields: [roleId], references: [id], onDelete: Cascade)

  @@unique([roleId, modulo])
}